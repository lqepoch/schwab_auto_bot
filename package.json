{
  "name": "schwab-owokit",
  "version": "1.0.0",
  "description": "TypeScript Charles Schwab API toolkit with a guarded automated order-execution module.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/public.js",
  "types": "./dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    },
    "./accounts": {
      "types": "./dist/accounts/accountHashResolver.d.ts",
      "import": "./dist/accounts/accountHashResolver.js"
    },
    "./orders": {
      "types": "./dist/orders/orderBuilders.d.ts",
      "import": "./dist/orders/orderBuilders.js"
    },
    "./options": {
      "types": "./dist/options/optionSymbol.d.ts",
      "import": "./dist/options/optionSymbol.js"
    },
    "./normalized-quotes": {
      "types": "./dist/types/normalizedQuotes.d.ts",
      "import": "./dist/types/normalizedQuotes.js"
    },
    "./streamer-fields": {
      "types": "./dist/types/levelOneFields.d.ts",
      "import": "./dist/types/levelOneFields.js"
    },
    "./streamer-market-data": {
      "types": "./dist/streamer/marketDataClient.d.ts",
      "import": "./dist/streamer/marketDataClient.js"
    },
    "./streamer-contracts": {
      "types": "./dist/types/streamerContracts.d.ts",
      "import": "./dist/types/streamerContracts.js"
    },
    "./streamer-snapshot": {
      "types": "./dist/streamer/streamerSnapshot.d.ts",
      "import": "./dist/streamer/streamerSnapshot.js"
    },
    "./gateway": {
      "types": "./dist/gateway/schwabGateway.d.ts",
      "import": "./dist/gateway/schwabGateway.js"
    },
    "./token-store": {
      "types": "./dist/auth/tokenStore.d.ts",
      "import": "./dist/auth/tokenStore.js"
    },
    "./contract-manifest": {
      "types": "./dist/contracts/contractManifest.d.ts",
      "import": "./dist/contracts/contractManifest.js"
    },
    "./automation": {
      "types": "./dist/automation/public.d.ts",
      "import": "./dist/automation/public.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/SDK_API_README.md"
  ],
  "scripts": {
    "start": "node src/automation/cli.ts",
    "auth:login": "node src/auth_cli.ts login",
    "auth:relogin": "node src/auth_cli.ts relogin --confirm REAUTHORIZE_SCHWAB",
    "auth:status": "node src/auth_cli.ts status",
    "build:sdk": "tsc -p tsconfig.sdk.json",
    "build:automation": "tsc -p tsconfig.automation.json",
    "build": "npm run build:sdk && npm run build:automation",
    "typecheck:sdk": "tsc -p tsconfig.sdk.json --noEmit",
    "typecheck:automation": "tsc -p tsconfig.automation.json --noEmit",
    "typecheck:runtime-native": "tsc -p tsconfig.automation.json --noEmit --verbatimModuleSyntax --erasableSyntaxOnly",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "typecheck:bench": "tsc -p tsconfig.bench.json --noEmit",
    "typecheck": "npm run typecheck:sdk && npm run typecheck:automation && npm run typecheck:runtime-native",
    "typecheck:test": "npm run build && tsc -p tsconfig.test.json --noEmit && npm run typecheck:examples && npm run typecheck:runtime-native && npm run typecheck:bench",
    "check": "npm run typecheck",
    "test:unit": "npm run build && node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "test": "npm run typecheck:test && node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "benchmark:runtime": "node --experimental-strip-types bench/runtime-benchmark.ts",
    "benchmark:runtime:baseline": "node --experimental-strip-types bench/build-runtime-baseline.ts",
    "benchmark:runtime:check": "node --experimental-strip-types bench/check-runtime-benchmark.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "open": "^10.1.0",
    "ws": "^8.21.0",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
