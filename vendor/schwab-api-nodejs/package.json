{
  "name": "schwab-owokit",
  "version": "1.0.0",
  "description": "TypeScript client for the Charles Schwab Trader, Market Data, and Streamer APIs.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/public.js",
  "types": "./dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    },
    "./accounts": {
      "types": "./dist/accounts/accountHashResolver.d.ts",
      "import": "./dist/accounts/accountHashResolver.js"
    },
    "./orders": {
      "types": "./dist/orders/orderBuilders.d.ts",
      "import": "./dist/orders/orderBuilders.js"
    },
    "./options": {
      "types": "./dist/options/optionSymbol.d.ts",
      "import": "./dist/options/optionSymbol.js"
    },
    "./normalized-quotes": {
      "types": "./dist/types/normalizedQuotes.d.ts",
      "import": "./dist/types/normalizedQuotes.js"
    },
    "./streamer-fields": {
      "types": "./dist/types/levelOneFields.d.ts",
      "import": "./dist/types/levelOneFields.js"
    },
    "./streamer-market-data": {
      "types": "./dist/streamer/marketDataClient.d.ts",
      "import": "./dist/streamer/marketDataClient.js"
    },
    "./streamer-contracts": {
      "types": "./dist/types/streamerContracts.d.ts",
      "import": "./dist/types/streamerContracts.js"
    },
    "./streamer-snapshot": {
      "types": "./dist/streamer/streamerSnapshot.d.ts",
      "import": "./dist/streamer/streamerSnapshot.js"
    },
    "./gateway": {
      "types": "./dist/gateway/schwabGateway.d.ts",
      "import": "./dist/gateway/schwabGateway.js"
    },
    "./token-store": {
      "types": "./dist/auth/tokenStore.d.ts",
      "import": "./dist/auth/tokenStore.js"
    },
    "./contract-manifest": {
      "types": "./dist/contracts/contractManifest.d.ts",
      "import": "./dist/contracts/contractManifest.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "npm run build && tsc -p tsconfig.test.json --noEmit",
    "test:unit": "npm run build && node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "test": "npm run typecheck:test && node --experimental-strip-types --test test/*.test.ts test/*.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "open": "^10.1.0",
    "ws": "^8.18.0",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  }
}
