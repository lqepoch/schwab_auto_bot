{
  "name": "schwab-owokit",
  "version": "1.0.0",
  "description": "TypeScript client for the Charles Schwab Trader, Market Data, and Streamer APIs.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./orders": {
      "types": "./dist/orders/orderBuilders.d.ts",
      "import": "./dist/orders/orderBuilders.js"
    },
    "./options": {
      "types": "./dist/options/optionSymbol.d.ts",
      "import": "./dist/options/optionSymbol.js"
    },
    "./normalized-quotes": {
      "types": "./dist/types/normalizedQuotes.d.ts",
      "import": "./dist/types/normalizedQuotes.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "npm run build && tsc -p tsconfig.test.json --noEmit",
    "test:unit": "npm run build && node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "test": "npm run typecheck:test && node --experimental-strip-types --test test/*.test.ts test/*.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "open": "^10.1.0",
    "ws": "^8.18.0",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  }
}
